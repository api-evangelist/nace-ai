              "body": "{\n  \"client\": \"string\",\n  \"window_seconds\": 2499,\n  \"sampled_at\": \"2002-02-15T19:01:10.434Z\",\n  \"in_flight\": {\n    \"pending\": 0,\n    \"running\": 0,\n    \"succeeded\": 0,\n    \"failed\": 0\n  },\n  \"in_window\": {\n    \"pending\": 0,\n    \"running\": 0,\n    \"succeeded\": 0,\n    \"failed\": 0\n  },\n  \"in_window_by_action\": {\n    \"parse\": {\n      \"pending\": 0,\n      \"running\": 0,\n      \"succeeded\": 0,\n      \"failed\": 0\n    },\n    \"ground\": {\n      \"pending\": 0,\n      \"running\": 0,\n      \"succeeded\": 0,\n      \"failed\": 0\n    },\n    \"extract_region\": {\n      \"pending\": 0,\n      \"running\": 0,\n      \"succeeded\": 0,\n      \"failed\": 0\n    },\n    \"segment_by_category\": {\n      \"pending\": 0,\n      \"running\": 0,\n      \"succeeded\": 0,\n      \"failed\": 0\n    }\n  }\n}",
